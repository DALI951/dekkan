# The dekkan API folder — keep secrets inside, keep the lameness out.
Options -Indexes

<Files "config.php">
  Require all denied
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# The shared host strips the Authorization header when PHP runs as CGI/FPM —
# feed it back into the request environment so Bearer tokens actually arrive.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>