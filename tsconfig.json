{
  "compilerOptions": {
    "target": "ES2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],

    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "noEmitOnError": false
  },
  "include": [
    "core/**/*.ts",
    "js/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "sw.ts",
    "globals.d.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "playwright.config.ts",
    "build-exe",
    "test-results",
    "playwright-report"
  ]
}
