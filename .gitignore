node_modules/
test-results/
playwright-report/

# TypeScript build output — generated from the .ts sources, never committed.
# The repo holds ONLY .ts sources; `npm run build` (tsc) emits these .js files.
/*.js
/core/*.js
/ui/*.js
/scripts/*.js
/test/*.js
*.tsbuildinfo
# firebase deploy cache (hosting): regenerated by firebase deploy, never part of the app
.firebase/

# agent scratch (playwright run logs): local only, never part of the app
*.out.txt
.e2e-*.txt
